---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  // OGP（SNSでシェアされたときに出るカード）で使う画像。サイト内の絶対パスで渡す（例: /images/hero/xxx.jpg）
  image?: string;
  // ページの種類。記事ページは 'article'、それ以外（トップ・About等）は 'website'
  type?: 'website' | 'article';
  // 記事の公開日。type が 'article' のときだけ使う
  publishedTime?: Date;
  // 記事の更新日（frontmatter の updatedDate）。内容を更新した記事だけ渡される。type が 'article' のときだけ使う
  modifiedTime?: Date;
}

const {
  title,
  description = 'Naokiのブログ',
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// OGP用のタイトルは、ブラウザのタブに出る <title> と同じ書式にそろえる
const ogTitle = `${title} - Naokiブログ`;

// 画像が指定されていないページ（トップ・About等）で使う共通の画像
const DEFAULT_OG_IMAGE = '/images/title/Cozy Sunlit Workspace with Colorful Notebooks.png';

// OGP画像は「https://〜」から始まる絶対URLでないとSNS側が読み込めないため、
// new URL でサイトのドメインを付ける（ファイル名の空白もここで自動的にエンコードされる）
const ogImageURL = new URL(image ?? DEFAULT_OG_IMAGE, Astro.site);

// 筆者（兼 運営者）の情報。個人運営のブログなので、会社（Organization）ではなく人（Person）として扱う
const AUTHOR_PERSON = {
  '@type': 'Person',
  name: 'Naoki',
  url: 'https://naoki-blog.com/about/',
};

// 構造化データ（JSON-LD）：検索エンジンに「これはブログ記事で、誰がいつ書いたか」を
// 機械が読める形で伝えるためのもの。記事ページ（type が 'article'）のときだけ作り、それ以外は null。
const articleJsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        // 公開日。記事ページでは必ず publishedTime が渡される想定
        datePublished: publishedTime?.toISOString(),
        // 更新日。updatedDate が無い記事は公開日と同じにする（Googleの推奨どおり必ず値を入れる）
        dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
        author: AUTHOR_PERSON,
        publisher: AUTHOR_PERSON,
        // OGP画像と同じ絶対URL（https://〜）を使う
        image: ogImageURL.href,
        // この記事の正式なURL（canonical と同じ）
        mainEntityOfPage: canonicalURL.href,
        inLanguage: 'ja',
      }
    : null;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1722999895287881"
    crossorigin="anonymous"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} - Naokiブログ</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* OGP：X・Facebook・LINE等でリンクを貼ったとき、画像付きカードで表示させるための設定 */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Naokiブログ" />
    <meta property="og:locale" content="ja_JP" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {/* 更新日：内容を更新した記事（updatedDate がある記事）だけ出す */}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}

    {/* 構造化データ（JSON-LD）：記事ページだけ出力。set:html で中身をそのまま書き出す。
        念のため「<」を < に置き換え、タイトル等に「</script>」が入っても
        タグが途中で閉じないようにしている（JSONとしての意味は変わらない） */}
    {articleJsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(articleJsonLd).replace(/</g, '\\u003c')}
      />
    )}

    {/* X（旧Twitter）用。summary_large_image を指定すると大きな画像付きカードになる */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WKG0GPTRGK"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WKG0GPTRGK');
    </script>
  </head>
  <body>
    <Header />
    <main class="site-main">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .site-main {
    padding: 48px 0 80px;
    min-height: calc(100vh - 56px);
  }
</style>
