---
import BaseLayout from './BaseLayout.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  prevPost?: CollectionEntry<'blog'> | null;
  nextPost?: CollectionEntry<'blog'> | null;
}

const { post, prevPost, nextPost } = Astro.props;
// heroImage・series・episode は任意項目。設定されている記事だけ、それぞれの要素を表示する
const { title, pubDate, category, description, heroImage, series, episode } = post.data;

const formattedDate = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// 連載記事のとき（series が設定されているとき）だけ、同じ連載の全話を集めて話数順に並べる。
// これで記事末尾に「この連載の一覧」を自動表示でき、話が増えても手作業でリンクを足す必要がない。
let seriesEpisodes: CollectionEntry<'blog'>[] = [];
if (series) {
  const allPosts = await getCollection('blog');
  seriesEpisodes = allPosts
    .filter((p) => p.data.series === series)
    .sort((a, b) => (a.data.episode ?? 0) - (b.data.episode ?? 0));
}
---

{/* 記事ページはOGPを「記事」として出す。カード画像にはその記事のアイキャッチをそのまま使う */}
<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishedTime={pubDate}
>
  <article class="blog-post">
    {/* アイキャッチ画像（heroImage が設定されている記事のみ・記事の一番上に表示） */}
    {heroImage && (
      <img src={heroImage} alt={title} class="post-hero" loading="eager" />
    )}
    <header class="post-header">
      <div class="post-meta">
        <span class="post-category">{category}</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      </div>
      {/* 連載ラベル：series が設定された記事だけ「📖 連載〈連載名〉第N回」を表示 */}
      {series && (
        <p class="series-label">📖 連載〈{series}〉{episode ? `第${episode}回` : ''}</p>
      )}
      <h1 class="post-title">{title}</h1>
    </header>
    <div class="post-content">
      <slot />
    </div>

    {/* 連載の全話リスト：series が設定された記事だけ自動表示（話が増えても手作業不要） */}
    {series && seriesEpisodes.length > 0 && (
      <aside class="series-box">
        <p class="series-box-title">📖 連載〈{series}〉</p>
        <ol class="series-list">
          {seriesEpisodes.map((ep) => (
            <li class={ep.slug === post.slug ? 'series-item current' : 'series-item'}>
              {ep.slug === post.slug ? (
                <span class="series-current-mark">▶ この記事</span>
              ) : (
                <a href={`/blog/${ep.slug}/`}>{ep.data.title}</a>
              )}
              {ep.slug === post.slug && <span class="series-current-title">{ep.data.title}</span>}
            </li>
          ))}
        </ol>
      </aside>
    )}

    {/* 筆者情報ボックス：全記事の末尾に自動表示（E-E-A-T対策・信頼性の明示） */}
    <aside class="author-box">
      <div class="author-avatar">N</div>
      <div class="author-info">
        <p class="author-label">この記事を書いた人</p>
        <p class="author-name">Naoki</p>
        <p class="author-bio">
          FP（ファイナンシャル・プランニング）・簿記・行政書士を学んだ50代会社員。製造現場でのPC管理経験も活かし、「知っているかどうかで差がつくお金とIT」の話を、同じ目線でわかりやすく発信しています。
        </p>
        <a href="/about/" class="author-link">プロフィールを見る →</a>
      </div>
    </aside>

    {/* メルマガ登録のおすすめ：書き手を知ってもらった直後がいちばん自然なので、
        筆者情報ボックスのすぐ下・前後記事ナビの手前に置いている */}
    <NewsletterCTA />
  </article>

  <nav class="post-nav">
    {prevPost ? (
      <a href={`/blog/${prevPost.slug}/`} class="post-nav-link prev">
        <span class="post-nav-label">← 前の記事</span>
        <span class="post-nav-title">{prevPost.data.title}</span>
      </a>
    ) : <div />}
    {nextPost && (
      <a href={`/blog/${nextPost.slug}/`} class="post-nav-link next">
        <span class="post-nav-label">次の記事 →</span>
        <span class="post-nav-title">{nextPost.data.title}</span>
      </a>
    )}
  </nav>
</BaseLayout>

<style>
  .blog-post {
    max-width: 680px;
    margin: 0 auto;
  }

  /* アイキャッチ画像：横幅いっぱい・角丸で、記事の先頭に表示 */
  .post-hero {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    margin-bottom: 28px;
  }

  /* 連載ラベル：タイトルの上に表示する小さな帯 */
  .series-label {
    display: inline-block;
    margin: 8px 0 4px;
    padding: 4px 12px;
    background: var(--gradient-hero);
    color: white;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 999px;
  }

  /* 連載の全話リスト：記事末尾のボックス */
  .series-box {
    margin-top: 40px;
    padding: 20px 24px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .series-box-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
  }
  .series-list {
    margin: 0;
    padding-left: 1.4em;
  }
  .series-item {
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .series-item a {
    color: #667eea;
    font-weight: 600;
  }
  /* 今読んでいる記事は太字＋マーカーで強調（リンクにはしない） */
  .series-item.current {
    color: var(--text-primary);
    font-weight: 700;
  }
  .series-current-mark {
    display: inline-block;
    margin-right: 6px;
    color: var(--color-dev, #667eea);
  }

  /* 筆者情報ボックス：記事末尾のプロフィール表示 */
  .author-box {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-top: 48px;
    padding: 20px 24px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .author-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--gradient-hero);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.3rem;
    font-weight: 800;
    flex-shrink: 0;
  }
  .author-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 2px;
  }
  .author-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .author-bio {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 8px;
  }
  .author-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: #667eea;
  }

  .post-header {
    margin-bottom: 40px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .post-category {
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 700;
  }

  .post-title {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .post-content {
    font-size: 1rem;
    line-height: 1.9;
    color: var(--text-secondary);
  }

  .post-content h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 40px 0 16px;
  }

  .post-content h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 28px 0 12px;
  }

  .post-content p {
    margin-bottom: 20px;
  }

  .post-content ul,
  .post-content ol {
    margin: 0 0 20px 24px;
  }

  .post-content li {
    margin-bottom: 8px;
  }

  .post-content code {
    font-family: 'SFMono-Regular', Consolas, monospace;
    background: #f0f0f0;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .post-content pre {
    background: #1a1a2e;
    color: #e0e0e0;
    padding: 20px;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 20px;
  }

  .post-content pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  :global(.post-content table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
    font-size: 0.95rem;
  }

  :global(.post-content th),
  :global(.post-content td) {
    border: 1px solid #dddddd;
    padding: 10px 14px;
    text-align: left;
    line-height: 1.6;
  }

  :global(.post-content th) {
    background: #f5f5f5;
    font-weight: 700;
    color: var(--text-primary);
  }

  :global(.post-content tr:nth-child(even) td) {
    background: #fafafa;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border-color);
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    background: var(--bg-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transition: transform 0.2s;
  }

  .post-nav-link:hover {
    transform: translateY(-2px);
  }

  .post-nav-link.next {
    text-align: right;
  }

  .post-nav-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .post-nav-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }
</style>
